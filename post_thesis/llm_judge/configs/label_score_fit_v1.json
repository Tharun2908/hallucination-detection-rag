  "score_input": "unrounded_float64_unsupported_log_odds_from_verified_raw_class_logprobs",
  "positive_label": 1,
  "sample_weighting": "equal_response_weight_no_class_or_task_weighting",
  "calibration": {
    "partition": "calibration",
    "required_rows": 600,
    "required_components": 100,
    "required_valid_fraction": 1.0,
    "require_both_classes": true,
    "method": "sigmoid(a * margin + b)",
    "standardization": "none",
    "objective": "mean(logaddexp(0, (1 - 2*y) * (a*margin + b))) + lambda/2 * ((a-1)**2 + b**2)",
    "lambda": 0.0001,
    "initial_parameters": {
      "a": 1.0,
      "b": 0.0
    },
    "bounds": {
      "a": [
        0.001,
        100.0
      ],
      "b": [
        -20.0,
        20.0
      ]
    },
    "optimizer": {
      "library": "scipy",
      "version": "1.14.1",
      "api": "scipy.optimize.minimize",
      "method": "L-BFGS-B",
      "analytic_jacobian": true,
      "dtype": "float64",
      "options": {
        "ftol": 1e-12,
        "gtol": 1e-08,
        "maxiter": 10000,
        "maxfun": 20000,
        "maxls": 50,
        "maxcor": 10
      }
    },
    "acceptance": {
      "optimizer_success_required": true,
      "all_values_finite": true,
      "max_abs_gradient": 1e-06,
      "min_absolute_distance_from_each_bound_exclusive": 1e-06,
      "max_objective_increase_from_initial": 1e-12
    },
    "on_failure": "record_no_calibrator; retain_independent_raw_score_and_threshold_analysis",
    "restarts_or_alternative_calibrators": false
  },
  "threshold": {
    "partition": "operating_threshold",
    "required_rows": 600,
    "required_components": 100,
    "required_valid_fraction": 1.0,
    "require_both_classes": true,
    "space": "raw_unsupported_log_odds",
    "objective": "maximize_response_level_positive_class_F1",
    "comparator": ">=",
    "candidates": "each_distinct_observed_finite_margin_plus_symbolic_above_max_all_negative",
    "candidate_sort": "ascending_margin; above_max_last",
    "tie_rule": "largest_threshold; compare_F1_fractions_by_exact_integer_cross_multiplication",
    "zero_division": 0,
    "missing_scores": "stop_selection_no_imputation_no_subset_no_replacements",
    "calibrator_required": false,
    "fixed_reference_margin": 0.0,
    "deployment_comparator": "raw_margin_greater_than_or_equal_to_frozen_raw_threshold"
